{
  "name": "hotkeys-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "vitest": "5.0.2"
    }
  },
  "scripts": {
    "build": "turbo run build --filter='@shaulavo/*'",
    "typecheck": "turbo run typecheck --filter='@shaulavo/*' && bun run docs:check",
    "docs:check": "bun scripts/check-samples.mjs",
    "lint": "bun scripts/check-source-language.ts && oxlint . && unknot packages/hotkeys/src",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test --filter='@shaulavo/*'",
    "verify": "bun run build && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run pack && bun run test:package",
    "pack": "node scripts/pack.mjs",
    "test:package": "node scripts/check-package.mjs && node scripts/check-package.mjs --bun",
    "test:browser": "node scripts/check-packed-browser.mts"
  },
  "devDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.65.1",
    "turbo": "2.11.5",
    "typescript": "7.0.2",
    "unknot": "0.1.2"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "vitest@5.0.2": "patches/vitest@5.0.2.patch",
    "@vitest/mocker@5.0.2": "patches/@vitest%2Fmocker@5.0.2.patch"
  }
}
