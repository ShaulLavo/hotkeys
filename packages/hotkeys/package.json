{
  "name": "@shaulavo/hotkeys",
  "version": "0.0.5",
  "description": "Keyboard shortcut registration, chords, context-aware keymaps, display formatting, and optional React hooks for browser and terminal apps.",
  "keywords": [
    "browser",
    "chords",
    "hotkeys",
    "keybindings",
    "keyboard",
    "react",
    "shortcuts",
    "typescript"
  ],
  "homepage": "https://github.com/ShaulLavo/hotkeys",
  "bugs": {
    "url": "https://github.com/ShaulLavo/hotkeys/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/hotkeys.git",
    "directory": "packages/hotkeys"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal/index.js",
      "default": "./dist/terminal/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js",
      "default": "./dist/adapter/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/store": "^0.11.1"
  },
  "devDependencies": {
    "@tanstack/react-store": "^0.11.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-store": "^0.11.1",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-store": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
